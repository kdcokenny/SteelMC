+    private void completeClaimed(final ChunkAccess chunk, final Throwable throwable, final boolean generation) {
+        final int previous = this.completionGate.claimCompletion();
+        if (previous == CompletionGate.COMPLETING) {
+            return;
+        }
+        if (previous == CompletionGate.CANCELLED || isCancellation(throwable)) {
+            this.complete(null, null);
+            return;
+        }
+        if (throwable != null) {
+            this.complete(null, throwable);
+            return;
+        }
+        if (chunk == null) {
+            this.complete(null, new IllegalStateException(
+                    "Chunk for status: " + this.toStatus + " should not be null"
+            ).fillInStackTrace());
+            return;
+        }
         try {
-            newChunk = completeFuture.join();
-        } catch (final Throwable throwable) {
-            this.complete(null, throwable);
-            return;
-        }
-
-        if (newChunk == null) {
-            this.complete(null,
-                    new IllegalStateException(
-                            "Chunk for status: " + ChunkUpgradeGenericStatusTask.this.toStatus.toString()
-                                    + ", generation: " + generation + " should not be null! Future: " + completeFuture
-                    ).fillInStackTrace()
-            );
-            return;
-        }
-
-        this.complete(newChunk, null);
-    }
-
+            if (generation && chunk instanceof ProtoChunk proto) {
+                proto.setPersistedStatus(this.toStatus);
+            }
+            this.complete(chunk, null);
+        } catch (final Throwable completionFailure) {
+            this.complete(null, completionFailure);
+        }
+    }
+
+    private static boolean isCancellation(Throwable throwable) {
+        while (throwable != null) {
+            if (throwable instanceof java.util.concurrent.CancellationException) {
+                return true;
+            }
+            throwable = throwable.getCause();
+        }
+        return false;
+    }
+
+    public static final class CompletionGate {
+        public static final int ACTIVE = 0;
+        public static final int CANCELLED = 1;
+        public static final int COMPLETING = 2;
+
+        private final AtomicInteger state = new AtomicInteger(ACTIVE);
+
+        public int claimCompletion() {
+            for (;;) {
+                final int current = this.state.get();
+                if (current == COMPLETING || this.state.compareAndSet(current, COMPLETING)) {
+                    return current;
+                }
+            }
+        }
+
+        public boolean requestCancellation() {
+            return this.state.compareAndSet(ACTIVE, CANCELLED);
+        }
+
+        public int state() {
+            return this.state.get();
+        }
+    }
+
+    private final CompletionGate completionGate = new CompletionGate();
     private volatile boolean scheduled;
     private static final VarHandle SCHEDULED_HANDLE = ConcurrentUtil.getVarHandle(ChunkUpgradeGenericStatusTask.class, "scheduled", boolean.class);
 
