     @Override
     public void cancel() {
+        if (!this.completionGate.requestCancellation()) {
+            return;
+        }
         if (this.generateTask.cancel()) {
-            this.complete(null, null);
+            this.completeClaimed(null, null, false);
         }
     }
 
